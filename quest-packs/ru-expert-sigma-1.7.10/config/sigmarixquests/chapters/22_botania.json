{"format":2,"chapters":[{"id":"botania","title":"Botania: мана и живые устройства","description":"40 заданий. Ключевые предметы только обнаруживаются; производственные испытания принимают указанные расходуемые образцы. Награды не выдают материалы следующих ступеней.","parent":"magic","icon":"Botania:lexicon"}],"quests":[{"id":"bot_book","title":"Лексика Ботании","description":"Лексика содержит точные схемы и рецепты цветов. Открывайте записи по мере получения новых материалов.","chapter":"botania","icon":"Botania:lexicon","iconMeta":0,"dependencies":["start_iron"],"tasks":[{"type":"item","target":"Botania:lexicon","meta":0,"count":1,"consume":false,"id":"goal","title":"Получить: Лексика Botania"}],"rewards":[{"id":"experience","type":"xp","count":8}],"autoComplete":true,"rewardMode":"individual","optional":false,"x":0.0,"y":0.0},{"id":"bot_petals","title":"Лепестковый аптекарь","description":"Заполните аптекарь водой, добавьте лепестки и завершите рецепт семенами.","chapter":"botania","icon":"Botania:altar","iconMeta":0,"dependencies":["bot_book"],"tasks":[{"type":"item","target":"Botania:altar","meta":0,"count":1,"consume":false,"id":"goal_1","title":"Получить: Лепестковый аптекарь"},{"type":"item","target":"Botania:petal","meta":0,"count":8,"consume":false,"id":"goal_2","title":"Получить: Мистический белый лепесток × 8"}],"rewards":[{"id":"experience","type":"xp","count":8}],"autoComplete":true,"rewardMode":"individual","optional":false,"x":2.5,"y":0.0},{"id":"bot_living","title":"Живые материалы","description":"Поставьте чистую маргаритку и окружите её подходящими блоками. Камень превращается в жизнекамень, древесина — в жизнедерево.","chapter":"botania","icon":"Botania:livingrock","iconMeta":0,"dependencies":["bot_petals"],"tasks":[{"type":"item","target":"Botania:livingrock","meta":0,"count":8,"consume":false,"id":"goal_1","title":"Получить: Жизнекамень × 8"},{"type":"item","target":"Botania:livingwood","meta":0,"count":8,"consume":false,"id":"goal_2","title":"